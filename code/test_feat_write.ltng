# Test 1: Basic write() with all literal types
write("hello world")
write("hello with spaces\ttab")
write('A')
write(42)
write(3.14)
write(true)
write(false)
write(t)
write(f)
# write with expression
write(2 + 3)
write(10 - 4)
write(3 * 7)
write(20 / 4)
write(17 % 5)
write(2 + 3 * 4)
write((2 + 3) * 4)
write(-5)
write(-3.14)
write(10.5 * 2)
