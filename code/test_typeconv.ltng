# Type conversion functions: toint(), tostring(), tobool()
# toint() - convert numeric string to number
# tostring() - convert value to string
# tobool() - convert to true/false (true unless null/empty/0/false)

# toint() conversion
write(toint("3.14"))
write(toint("10"))
write(toint(-5))
let s = "42"
write(toint(s))

# tostring() conversion
write(tostring(true))
write(tostring(false))
write(tostring(42))
write(tostring("hello"))

# tobool() conversion
write(tobool("true"))
write(tobool("false"))
write(tobool(0))
write(tobool(42))
write(tobool(""))

# Combined
let x = toint("100") + toint("25")
write(x)
let y = tostring(x)
write(y)
let b = tobool("1")
write(b)