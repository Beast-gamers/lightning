# Test 8: Edge cases and combinations
# Deeply nested parens
let b = ((2 + 3) * (4 - 1)) / 5
write(b)

# Unary minus with variables
let c = 10
let d = -c
write(d)

# Mixed int/float
let e = 2 + 3.5
write(e)

# Comparison chain result
let g = (5 > 3) == 1
write(g)

# Logical with comparisons
let h = (10 > 5) && (3 < 7)
write(h)

# Not with comparison
let ii = !(5 < 3)
write(ii)

# Set with complex expression
let jj = 0
set jj = (5 + 3) * 2 - 1
write(jj)

# Expression in write with many ops
write(1 + 2 * 3 - 4 / 2 + 10 % 3)

# Float division
let kk = 10 / 3
write(kk)
let ll = 10.0 / 3.0
write(ll)

# Bool expressions
let mm = true && false || true
write(mm)
let nn = !false && true
write(nn)

# Variable-to-variable assignment
let aa = 42
let bb = aa
write(bb)

# set variable to variable
let cc = 100
set cc = bb
write(cc)

