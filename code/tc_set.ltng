# Comprehensive set tests
# Covers: all type changes, expressions, variable-to-variable,
#         C keyword targets, edge cases

# --- Basic set ---
let a = 10
write(a)
set a = 20
write(a)
set a = 30
write(a)

# --- Set same type ---
let b = 42
write(typeof(b))
set b = 100
write(typeof(b))
set b = 255
write(typeof(b))
set b = -7
write(typeof(b))
write(b)

# --- Set with expression ---
let c = 0
set c = 10 + 5
write(c)
set c = c * 2
write(c)
set c = c - 10
write(c)

# --- Set from variable ---
let d = 0
let e = 99
set d = e
write(d)

# --- Set on C keyword variable ---
let ret = 1
write(ret)
set ret = 42
write(ret)
set ret = ret + 1
write(ret)

# --- Set same type repeatedly ---
let h = 1
write(typeof(h))
set h = 10
write(typeof(h))
set h = 100
write(typeof(h))
set h = -50
write(typeof(h))
set h = 1000
write(typeof(h))

# --- Set with unary minus ---
let i = 5
set i = -i
write(i)
set i = -(-i)
write(i)

# --- Set from typeof expression ---
let j = string
set j = typeof(42)
write(j)

# --- Set with bitwise ops ---
let k = 0
set k = 15 ^^ 9
write(k)
set k = 12 && 10
write(k)
set k = 12 || 10
write(k)
