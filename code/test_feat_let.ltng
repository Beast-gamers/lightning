# Test 2: let with all forms
# Inferred types
let x = 42
let y = 3.14
let s = "hello"
let c = 'X'
let b = true
let b2 = false

# Explicit types
let ex = 42
let ef = 3.14
let es = "hello"
let ec = 'X'
let eb = true

# Uninitialized defaults
let ux = int
let uy = float
let us = string
let uc = char
let ub = bool

# Variables to variables
let v = x
let w = y

write(x)
write(y)
write(s)
write(c)
write(b)
write(b2)
write(ex)
write(ef)
write(es)
write(ec)
write(eb)
write(ux)
write(uy)
write(us)
write(uc)
write(ub)
write(v)
write(w)
