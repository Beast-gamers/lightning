# Nested functions (defined inside other functions)

function outer(a) {
    function double(n) {
        return n * 2
    }
    function inc(n) {
        return n + 1
    }
    # nested functions can call each other and be used in expressions
    return inc(double(a))
}

write(outer(5))    # 11
write(outer(10))   # 21

# Deeper nesting (non-capturing: pass values as parameters)
function make() {
    function level1(x) {
        function level2(y) {
            return y * 2
        }
        return level2(x) + 5
    }
    return level1(10)
}
write(make())      # 25

# Same nested name in different scopes (isolated by unique lifted names)
function one() {
    function helper() { return 1 }
    return helper()
}
function two() {
    function helper() { return 2 }
    return helper()
}
write(one())       # 1
write(two())       # 2
