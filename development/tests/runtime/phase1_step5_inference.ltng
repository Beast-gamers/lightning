# Phase 1 Step 5: type inference and numeric promotion

function id(x) { return x }
function mk() { return "sf" }
function sf() { return "abc" }
function retfloat() { return 1.5 }
function retint() { return 2 }
function pick(a, b, c) { return a ? b : c }

# bool inference and propagation
let b = true
let c = b
write(typeof(b))
write(typeof(c))
write(c)
write(typeof(true && false))
write(typeof(!true))

# comparison/logical in mixed numeric expressions (promotion)
write((1 < 2) + 0.5)
write(typeof((1 < 2) + 0.5))
let p = (1 < 2) + 0.5
write(p)
write(typeof(p))
write((2 > 3) + 1)
write((true && true) + 0.25)
write(typeof((true && true) + 0.25))

# chained/nested expressions and calls
write(id(5) + 0.5)
write(typeof(id(5) + 0.5))
write(id(3.5) + 1)
write(typeof(id(3.5) + 1))
write(mk()())
let ch = mk()()
write(ch)
write(typeof(ch))
write(id(id(2)) + 0.5)
write(typeof(id(id(2)) + 0.5))

# string condition truthiness
let s0 = "0"
if (s0) { write("bad") } else { write("ok0") }
if ("") { write("bad") } else { write("okempty") }
if ("false") { write("bad") } else { write("okfalse") }
if ("f") { write("bad") } else { write("okf") }
if ("hello") { write("okstr") } else { write("bad") }

# typeof in interpolation with object field
let o = { n = 1 }
write("$[typeof(o.n)]")

# inc/dec typing on string/bool
let sn = "3"
write(++sn)
write(sn)
let bb = true
write(bb++)
write(bb)

# array/object access and mixed inference
let ai = [1, 2, 3]
write(ai[1] + 0.5)
write(typeof(ai[1] + 0.5))
let af = [1.5, 2]
write(af[2] + 1)
write(typeof(af[2] + 1))
write(o.n + 0.5)
write(typeof(o.n + 0.5))

# declarations/assignments/returns/args/conditions in mixed contexts
let m = 1 + 2.5
write(m)
write(typeof(m))
let z = 1
set z = z + 2.5
write(z)
write(typeof(z))
function retm(a) { return a + 0.5 }
write(retm(1))
write(typeof(retm(1)))
function condv(x) { if (x) { return 1 } else { return 0 } }
write(condv("0"))
write(condv("x"))

# ternary/conditional expressions
write(1 < 2 ? 10 : 20)
write(1 > 2 ? 10 : 20)
write(typeof(1 < 2 ? 1 : 2))
write(typeof(1 < 2 ? 1.0 : 2))
write(typeof(1 < 2 ? "a" : "b"))
write(typeof(1 < 2 ? true : false))
write(1 < 2 ? 3 < 4 ? 1 : 2 : 3)
write(1 > 2 ? 1 : 3 < 4 ? 2 : 3)
write(1 > 2 ? 1 : 3 > 4 ? 2 : 3)
let tv = 1 < 2 ? 1 : 1.5
write(tv)
write(typeof(tv))
let tv2 = 1 > 2 ? 1 : 1.5
write(tv2)
write(typeof(tv2))
function terna(x) { return x > 0 ? 1 : 0 }
write(terna(5))
write(terna(-1))
write(pick(true, 7, 8))
write(pick(false, 7, 8))
write(pick(1 < 2, "yes", "no"))
write(pick(1 > 2, "yes", "no"))
let ts = ""
write(ts ? "bad" : "empty")
let th = "hi"
write(th ? "ok" : "bad")
write((1 < 2 ? 3 : 4) + 1)
write(1 > 2 ? 3 : 4 + 1)
set tv = 1 > 2 ? 99 : 100
write(tv)

# numeric promotion matrix and mixed expressions
write(1 + 1.5)
write(typeof(1 + 1.5))
write(1.5 + 1)
write(2 * 1.5)
write(typeof(2 * 1.5))
write(1 - 0.25)
write(typeof(1 - 0.25))
write(typeof(1.0 / 2))
write((1 < 2) + (3 > 2))
write(typeof((1 < 2) * 1.5))

# unary and conversions in expressions
write(-1)
write(typeof(-1))
write(-1.5)
write(typeof(-1.5))
write(typeof(toint(1.5)))
write(typeof(tofloat(1)))
write(typeof(tostring(1)))
write(typeof(tobool(1)))
write(toint(1.9))
write(tofloat(2))
write(toint(1.5) + 0.5)
let tc = toint(1.5) + 0.5
write(typeof(tc))

# nested/complex expressions
write(1 + 2 * 3)
write((1 + 2) * 0.5)
write(typeof((1 + 2) * 0.5))
write((1 < 2 ? 1 : 2) + (3 < 4 ? 0.5 : 1.5))
write(typeof((1 < 2 ? 1 : 2) + (3 < 4 ? 0.5 : 1.5)))

# inference in args/conditions/returns
write(retfloat() + 1)
write(typeof(retfloat() + 1))
write(retint() + 0.5)
write(typeof(retint() + 0.5))
if (1.5) { write("nzf") } else { write("bad") }
if (0.0) { write("bad") } else { write("zf") }
write(id(1 < 2 ? 1.5 : 2))
write(typeof(id(1 < 2 ? 1.5 : 2)))

# edge numeric values
write(0 + 0.0)
write(typeof(0 + 0.0))
write(-1 + 0.5)
write(typeof(-1 + 0.5))
write(1 < 2 ? -1 : -2)
write(typeof(1 < 2 ? -1 : -2))

# typeof with conversion expressions in larger expressions
write(typeof(toint(3.7) + 1))
write(typeof(toint(3) + 1.5))
write(typeof(1.5 + toint(3)))
write(typeof(tofloat(3) + 0.5))
write(typeof(tobool(1) + 1.5))
write(1.5 + toint(3))
write(toint(3) + 1.5)
write(tobool(1) + 1.5)

# typeof in interpolation with complex expressions
write("$[typeof(toint(3) + 1.5)]")
write("$[typeof(1.5 + toint(3))]")
write("$[typeof(1 + 1.5)]")
write("$[typeof(toint(3) + 1)]")
write("$[typeof(42)]")
write("$[typeof(3.14)]")
write("$[typeof(true && false)]")
write("$[typeof(1 < 2)]")

# compound assignment with ternary RHS
let cy = 10
set cy += 1 < 2 ? 5 : 0
write(cy)
set cy -= 1 > 2 ? 1 : 3
write(cy)
set cy *= 1 < 2 ? 2 : 1
write(cy)

# ternary in switch expression
switch (1 < 2 ? 2 : 3) {
    case 1: { write("one") }
    case 2: { write("two") }
    default: { write("other") }
}

# indirect call in mixed expression
let idfn = id
write(idfn(5) + 0.5)
write(typeof(idfn(5) + 0.5))

# nested typeof/conversion contexts
write(typeof(toint(1.5) + tofloat(1)))
write(typeof(toint(tofloat(3)) + 0.5))
