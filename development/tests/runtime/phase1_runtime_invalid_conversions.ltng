let s = "abc"
try { write(toint(s)) } catch (e) { write(e.type) }
try { write(tofloat(s)) } catch (e) { write(e.type) }
let e = ""
try { write(toint(e)) } catch (e) { write(e.type) }
try { write(tofloat(e)) } catch (e) { write(e.type) }
let n = "12x"
try { write(toint(n)) } catch (e) { write(e.type) }
try { write(tofloat(n)) } catch (e) { write(e.type) }
write(toint("12"))
write(tofloat("12.5"))
