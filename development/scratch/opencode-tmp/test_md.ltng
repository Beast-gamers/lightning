# Test 1D array
let arr = [1, 2, 3]
write(arr[1])
write(arr[2])
write(arr[3])
write(arr[-1])
write(arr[-2])
write(arr[-3])

# Test 2D array
let m = [[1, 2, 3], [4, 5, 6]]
write(m[1][1])
write(m[1][2])
write(m[1][3])
write(m[2][1])
write(m[2][2])
write(m[2][3])
write(m[-1][-1])
write(m[-1][-2])

# Test string 2D array
let names = [["a", "b"], ["c", "d"]]
write(names[1][1])
write(names[1][2])
write(names[2][1])
write(names[2][2])

# Test 3D array
let cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
write(cube[1][1][1])
write(cube[1][1][2])
write(cube[1][2][1])
write(cube[2][1][1])
write(cube[2][2][2])
write(cube[-1][-1][-1])
