# UFCS / method-style calls
# A function can be called as: receiver.func(args...) which is equivalent
# to func(receiver, args...).
#
# Base-parameter UDMs (first parameter named "base") and predefined/array
# methods follow this rule:
#   * Statement form (result discarded): apply to the receiver/base.
#   * Value-consumed context (let/set, args, conditions, write, return, ...):
#     keep the original receiver intact and use the method's return value.
# For chained calls in value-consumed contexts, operate on a temp/working value
# through the chain and use the final method's return value.
#
# Base-parameter UDMs cannot be called as plain functions:
#   baseFunc(receiver, args) is an error; use receiver.baseFunc(args).

function a(p) {
    return p + 1
}

let x = 5
write(x.a())        # 6  (same as a(x))
write(a(x))         # 6
write(x)            # 5 (unchanged - statement call discarded return)

function add(recv, n) {
    return recv + n
}

write(x.add(10))    # 15  (same as add(x, 10))
let y = x.add(3)    # 8
write(y)            # 8
write(x.add(1))     # 6
write(x)            # 5 (unchanged - x not modified)

if (x.add(4) == 9) {
    write("ok")
} else {
    write("bad")
}

# --- base parameter: return value is assigned to receiver ---
function inc(base, n) {
    return base + n
}

let b = 5
b.inc(10)           # b = b + 10 = 15
write(b)            # 15
b.inc(3)            # b = 15 + 3 = 18
write(b)            # 18

# --- base parameter in value-consumed context: receiver unchanged, return value used ---
let before = b
let c = b.inc(2)    # b unchanged, c = 20
write(b)            # 18
write(c)            # 20
write(b.inc(1))     # 19 (b still unchanged)
write(b)            # 18

# --- base parameter: plain call is rejected (compile error) ---
# inc(b, 5)         # error: must use method syntax
